    <string name="oneui_media_summary">Shows One UI\'s camera and screenshots in ColorOS, read-only: ColorOS cannot edit or delete them. Applies at the next switch or guest restart.</string>
    <string name="oneui_media_asking">Asking root…</string>
    <string name="oneui_media_problem">Nothing was changed: %1$s</string>
    <string name="oneui_media_unread">Not read: %1$s</string>
    <string name="oneui_media_not_marker">Off: %1$s. Remove it from a root shell, then turn this on.</string>
</resources>
