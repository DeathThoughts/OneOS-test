<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings, One UI photos (build 156; first in Advanced). These name ColorOS on purpose, so they are kept out of
    strings_advanced.xml, whose texts StringsNeutralTest keeps free of system names: the sharing
    exists only in a ColorOS guest (guest_start.sh checks the prepared image), and a neutral name
    would promise it in every system.
-->
<resources>
    <string name="oneui_media_title">One UI photos in ColorOS</string>
    <string name="oneui_media_summary">Shows One UI\'s albums in ColorOS, each as its own album, read-only: ColorOS cannot edit or delete them. Nothing in One UI\'s Android folder is shared. Applies at the next switch or guest restart.</string>
    <string name="oneui_media_asking">Asking root…</string>
    <string name="oneui_media_problem">Nothing was changed: %1$s</string>
    <string name="oneui_media_unread">Not read: %1$s</string>
    <string name="oneui_media_not_marker">Off: %1$s. Remove it from a root shell, then turn this on.</string>
    <!-- The album picker (owner's decision after the Galaxy S25 Ultra, session 92032e7ae892154c). -->
    <string name="oneui_media_albums_title">Choose albums</string>
    <string name="oneui_media_albums_all">All albums</string>
    <string name="oneui_media_albums_count">%1$d of %2$d albums shown</string>
    <string name="oneui_media_albums_none">One UI has no album with photos or videos to share. Folders in Android are never shared.</string>
    <string name="oneui_media_album_row">%1$s · %2$s · %3$d</string>
    <string name="oneui_media_album_top">Internal storage</string>
    <string name="oneui_media_albums_save">Save</string>
    <string name="oneui_media_albums_bad_list">ColorOS shows no album: the list of hidden albums %1$s. Saving a choice replaces a wrong file; a link or a folder there must be removed from a root shell first.</string>
    <string name="oneui_media_albums_left_out">%1$d albums with very long folder paths cannot be listed here; ColorOS shows them.</string>
</resources>
