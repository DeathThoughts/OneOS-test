<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/catalog_card_clip" android:clipToOutline="true">
    <com.fahadali.oneos.ui.OsArtworkView android:id="@+id/systems_artwork" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="72dp"
        android:background="@drawable/catalog_overlay_bg"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/systems_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/systems_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E5FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/systems_more" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|top" android:layout_margin="12dp" android:background="@drawable/catalog_overlay_bg" android:src="@drawable/ic_catalog_more" android:contentDescription="@string/catalog_more" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/systems_primary" style="@style/OneUI.ContainedButton" android:theme="@style/OneUI.ContainedButtonTheme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="168dp" android:layout_gravity="bottom|center_horizontal" android:layout_margin="16dp" android:text="@string/catalog_set_up" />
</FrameLayout>
