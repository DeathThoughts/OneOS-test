<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/environment_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:paddingVertical="12dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginHorizontal="16dp">
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/environment_boot"
        style="@style/OneUI.ContainedButton"
        android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="56dp" android:textSize="17sp" android:textStyle="bold"
        android:paddingHorizontal="20dp" android:paddingVertical="14dp"
        android:backgroundTint="@color/preboot_primary" />
    <com.fahadali.oneos.ui.LoadingSpinner
        android:id="@+id/environment_action_spinner"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/white"
        android:importantForAccessibility="no"
        android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
